{
  "appId": "com.pothik.ride",
  "appName": "Pothik",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0A7C5A",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
